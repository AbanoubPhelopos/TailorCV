# ─── Infrastructure ───────────────────────────────────────
POSTGRES_USER=tailorcv
POSTGRES_PASSWORD=<your-password>
POSTGRES_DB=tailorcv
RABBITMQ_USER=guest
RABBITMQ_PASS=<your-password>
RABBITMQ_MANAGEMENT_PORT=15672

# ─── API ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
RabbitMQ__ConnectionString=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672
Redis__Configuration=redis:6379
JwtSettings__Secret=<your-jwt-secret-at-least-32-chars>
JwtSettings__Issuer=TailorCV
JwtSettings__Audience=TailorCV
JwtSettings__AccessTokenExpiryMinutes=15
JwtSettings__RefreshTokenExpiryDays=7
S3__Endpoint=http://rustfs:9000
S3__AccessKey=<your-s3-access-key>
S3__SecretKey=<your-s3-secret>
S3__BucketName=tailorcv

# ─── Worker ────────────────────────────────────────────────
OPENAI_API_KEY=<your-openai-or-openrouter-api-key>
OPENAI__ApiKey=${OPENAI_API_KEY}
OPENAI__Endpoint=https://openrouter.ai/api/v1
OPENAI__ModelId=gpt-4o
OPENAI__MaxTokens=2048
Playwright__MaxConcurrency=3
Playwright__RequestTimeoutMs=30000
PLAYWRIGHT_SKIP_INSTALL=true
