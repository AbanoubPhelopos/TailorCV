# ─── Infrastructure ───────────────────────────────────────
POSTGRES_USER=tailorcv
POSTGRES_PASSWORD=<your-password>
POSTGRES_DB=tailorcv

RABBITMQ_USER=guest
RABBITMQ_PASS=<your-password>
RABBITMQ_MANAGEMENT_PORT=15672

RUSTFS_ACCESS_KEY=<your-s3-access-key>
RUSTFS_SECRET_KEY=<your-s3-secret-key>

# ─── API ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

RabbitMQ__ConnectionString=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672

Redis__Configuration=redis:6379

Identity__Jwt__Secret=<your-jwt-secret-at-least-32-chars>
Identity__Jwt__Issuer=TailorCV
Identity__Jwt__Audience=TailorCV
Identity__Jwt__AccessTokenExpiryMinutes=15
Identity__Jwt__RefreshTokenExpiryDays=7

BlobStorage__Endpoint=http://rustfs:9000
BlobStorage__AccessKey=3g8WoQQO9hBWviKSdiNM
BlobStorage__SecretKey=0oww93Yrav5TKvtofdOZFPBCfPbOVfUA1OGvgdSj
BlobStorage__BucketName=tailorcv

CVGenerator__InternalGrpc__Address=http://api:8080

# ─── Workers (shared) ──────────────────────────────────────
OPENAI_API_KEY=<your-openai-or-openrouter-api-key>
OPENAI_ENDPOINT=https://openrouter.ai/api/v1

# ─── JD Worker ─────────────────────────────────────────────
JobDescriptions__OpenAI__ApiKey=${OPENAI_API_KEY}
JobDescriptions__OpenAI__Endpoint=${OPENAI_ENDPOINT}
JobDescriptions__OpenAI__ModelId=gpt-4o
JobDescriptions__OpenAI__MaxTokens=2048

JobDescriptions__Playwright__MaxConcurrency=3
JobDescriptions__Playwright__RequestTimeoutMs=30000

PLAYWRIGHT_SKIP_INSTALL=true

# ─── Profile Worker ────────────────────────────────────────
Profile__OpenAI__ApiKey=${OPENAI_API_KEY}
Profile__OpenAI__Endpoint=${OPENAI_ENDPOINT}
Profile__OpenAI__ModelId=gpt-4o
Profile__OpenAI__MaxTokens=4096

# ─── CVGenerator Worker ────────────────────────────────────
CVGenerator__OpenAI__ApiKey=${OPENAI_API_KEY}
CVGenerator__OpenAI__Endpoint=${OPENAI_ENDPOINT}
CVGenerator__OpenAI__ModelId=gpt-4o-mini
CVGenerator__OpenAI__MaxTokens=4096
