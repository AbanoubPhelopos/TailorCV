{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://guest:guest@localhost:5672"
  },
  "JobDescriptions": {
    "OpenAI": {
      "Endpoint": "https://openrouter.ai/api/v1",
      "ModelId": "gpt-4o",
      "MaxTokens": 2048
    },
    "Playwright": {
      "MaxConcurrency": 3,
      "RequestTimeoutMs": 30000
    }
  }
}
